{
  "$schema": "./schemas/api-contract.schema.json",
  "feature": "功能名称",
  "description": "功能描述",
  "version": "1.0.0",
  "created_at": "2026-03-21",
  "updated_at": "2026-03-21",
  
  "backend": {
    "endpoints": [
      {
        "path": "/api/xxx",
        "method": "POST|GET|PUT|DELETE",
        "description": "接口描述",
        "request": {
          "headers": {
            "Authorization": { "type": "string", "required": true, "description": "Bearer token" }
          },
          "body": {
            "field1": { "type": "string", "required": true, "description": "字段说明" },
            "field2": { "type": "number", "required": false, "default": 0 }
          }
        },
        "response": {
          "success": {
            "status": 200,
            "body": {
              "code": { "type": "number", "example": 200 },
              "message": { "type": "string", "example": "success" },
              "data": { "type": "object" }
            }
          },
          "error": {
            "status": 400,
            "body": {
              "code": { "type": "number", "example": 400 },
              "message": { "type": "string", "example": "参数错误" }
            }
          }
        },
        "error_codes": {
          "400": "参数校验失败",
          "401": "未登录或Token过期",
          "403": "无权限访问",
          "404": "资源不存在",
          "409": "资源冲突（如重复操作）",
          "500": "服务器内部错误"
        }
      }
    ]
  },
  
  "frontend": {
    "pages": [
      {
        "path": "/pages/xxx/index",
        "description": "页面描述",
        "elements": {
          "element_key": {
            "type": "button|input|text|image|list",
            "selector": "css选择器或标识",
            "text": "显示文本",
            "events": ["click", "input", "scroll"]
          }
        },
        "flow": [
          "1. 用户进入页面",
          "2. 页面加载数据",
          "3. 用户交互",
          "4. 提交数据"
        ],
        "state_management": {
          "loading": "加载中状态",
          "empty": "空状态",
          "error": "错误状态",
          "success": "成功状态"
        }
      }
    ]
  },
  
  "qa": {
    "test_cases": [
      {
        "id": "TC001",
        "title": "测试用例标题",
        "type": "positive|negative|edge",
        "priority": "P0|P1|P2",
        "preconditions": ["前置条件"],
        "steps": [
          "1. 操作步骤1",
          "2. 操作步骤2"
        ],
        "expected": "预期结果",
        "data": { "测试数据": "值" }
      }
    ],
    "automation": {
      "api_tests": true,
      "e2e_tests": true,
      "unit_tests": true
    }
  }
}

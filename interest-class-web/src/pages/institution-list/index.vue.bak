<template>
  <view class="page">
    <!-- 搜索栏 -->
    <view class="search-bar">
      <wd-input
        v-model="searchKeyword"
        placeholder="搜索机构名称"
        clearable
        @confirm="handleSearch"
      >
        <template #suffix>
          <wd-icon name="search" @click="handleSearch" />
        </template>
      </wd-input>
    </view>

    <!-- 筛选栏 -->
    <view class="filter-bar">
      <view class="filter-item" @click="showCategoryPicker = true">
        <text>{{ selectedCategoryLabel || '分类' }}</text>
        <wd-icon name="arrow-down" />
      </view>
      <view class="filter-item" @click="showAreaPicker = true">
        <text>{{ selectedAreaLabel || '地区' }}</text>
        <wd-icon name="arrow-down" />
      </view>
    </view>

    <!-- 机构列表 -->
    <view class="institution-list">
      <view
        v-for="item in institutionList"
        :key="item.id"
        class="institution-item"
        @click="goToDetail(item.id)"
      >
        <view class="item-left">
          <asyncimage
            :src="item.logo"
            width="160rpx"
            height="160rpx"
            mode="aspectFill"
            :radius="16"
          />
        </view>
        <view class="item-right">
          <view class="item-name">{{ item.name }}</view>
          <view class="item-intro" v-if="item.introduction">
            {{ item.introduction }}
          </view>
          <view class="item-tags" v-if="item.tags">
            <text
              v-for="(tag, index) in item.tags.split(',')"
              :key="index"
              class="tag"
            >
              {{ tag }}
            </text>
          </view>
          <view class="item-address" v-if="item.address">
            <wd-icon name="location" size="24rpx" />
            <text>{{ item.address }}</text>
          </view>
        </view>
      </view>

      <!-- 加载更多 -->
      <view class="load-more" v-if="institutionList.length > 0">
        <text v-if="loading">加载中...</text>
        <text v-else-if="noMore">没有更多了</text>
        <text v-else @click="loadMore">加载更多</text>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" v-if="!loading && institutionList.length === 0">
        <wd-icon name="shop" size="120rpx" color="#d9d9d9" />
        <text class="empty-text">暂无机构</text>
      </view>
    </view>

    <!-- 分类选择器 -->
    <wd-picker
      v-model="showCategoryPicker"
      :columns="categoryColumns"
      @confirm="handleCategoryConfirm"
      @cancel="showCategoryPicker = false"
    />

    <!-- 地区选择器 -->
    <wd-picker
      v-model="showAreaPicker"
      :columns="areaColumns"
      @confirm="handleAreaConfirm"
      @cancel="showAreaPicker = false"
    />
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { onReachBottom } from '@dcloudio/uni-app'
import { institutionApi, type Institution } from '@/api/institution'
import { useEnums } from '@/composables/useEnums'

const { loadEnumsByTypes, getEnumLabel, ENUM_TYPES } = useEnums()

// 搜索关键词
const searchKeyword = ref('')

// 筛选条件
const selectedCategory = ref('')
const selectedCategoryLabel = ref('')
const selectedArea = ref('')
const selectedAreaLabel = ref('')

// 分类选择器
const showCategoryPicker = ref(false)
const categoryColumns = ref<any[]>([])

// 地区选择器
const showAreaPicker = ref(false)
const areaColumns = ref([
  { label: '不限', value: '' },
  { label: '北京', value: '北京' },
  { label: '上海', value: '上海' },
  { label: '广州', value: '广州' },
  { label: '深圳', value: '深圳' },
  { label: '杭州', value: '杭州' },
  { label: '成都', value: '成都' },
])

// 机构列表
const institutionList = ref<Institution[]>([])
const loading = ref(false)
const page = ref(1)
const pageSize = ref(10)
const total = ref(0)
const noMore = ref(false)

onMounted(async () => {
  await loadCategories()
  await loadInstitutions()
})

// 加载分类
const loadCategories = async () => {
  await loadEnumsByTypes([ENUM_TYPES.INSTITUTION_CATEGORY])
  const enums = useEnums()
  const categoryEnums = enums.getEnumsByType(ENUM_TYPES.INSTITUTION_CATEGORY)
  categoryColumns.value = [
    { label: '不限', value: '' },
    ...categoryEnums.map((item: any) => ({
      label: item.label,
      value: item.value,
    })),
  ]
}

// 加载机构列表
const loadInstitutions = async (isLoadMore = false) => {
  if (loading.value) return

  loading.value = true
  try {
    const params: any = {
      page: page.value,
      pageSize: pageSize.value,
    }

    if (searchKeyword.value) {
      params.keyword = searchKeyword.value
    }
    if (selectedCategory.value) {
      params.category = selectedCategory.value
    }
    if (selectedArea.value) {
      params.city = selectedArea.value
    }

    const res = await institutionApi.getList(params)
    
    if (isLoadMore) {
      institutionList.value = [...institutionList.value, ...res.data]
    } else {
      institutionList.value = res.data
    }

    total.value = res.total
    noMore.value = institutionList.value.length >= res.total
  } catch (error: any) {
    uni.showToast({
      title: error.message || '加载失败',
      icon: 'none',
    })
  } finally {
    loading.value = false
  }
}

// 搜索
const handleSearch = () => {
  page.value = 1
  noMore.value = false
  loadInstitutions()
}

// 分类确认
const handleCategoryConfirm = ({ value }: any) => {
  selectedCategory.value = value[0].value
  selectedCategoryLabel.value = value[0].label === '不限' ? '' : value[0].label
  showCategoryPicker.value = false
  page.value = 1
  noMore.value = false
  loadInstitutions()
}

// 地区确认
const handleAreaConfirm = ({ value }: any) => {
  selectedArea.value = value[0].value
  selectedAreaLabel.value = value[0].label === '不限' ? '' : value[0].label
  showAreaPicker.value = false
  page.value = 1
  noMore.value = false
  loadInstitutions()
}

// 加载更多
const loadMore = () => {
  if (noMore.value || loading.value) return
  page.value++
  loadInstitutions(true)
}

// 触底加载
onReachBottom(() => {
  loadMore()
})

// 跳转到详情
const goToDetail = (id: string) => {
  uni.navigateTo({
    url: `/pages/institution-detail/index?id=${id}`,
  })
}
</script>

<style lang="scss" scoped>
.page {
  min-height: 100vh;
  background-color: $uni-bg-color-grey;
}

.search-bar {
  padding: 24rpx 32rpx;
  background-color: $uni-bg-color;
}

.filter-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: $uni-bg-color;
  border-bottom: 1rpx solid $uni-border-color-light;
  gap: 32rpx;
}

.filter-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: $uni-text-color;
  
  text {
    max-width: 150rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
}

.institution-list {
  padding: 24rpx 32rpx;
}

.institution-item {
  display: flex;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background-color: $uni-bg-color;
  border-radius: 16rpx;
  gap: 24rpx;
}

.item-left {
  flex-shrink: 0;
}

.item-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  overflow: hidden;
}

.item-name {
  font-size: 32rpx;
  font-weight: bold;
  color: $uni-text-color;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-intro {
  font-size: 26rpx;
  color: $uni-text-color-secondary;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.5;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 4rpx 12rpx;
  font-size: 24rpx;
  color: $uni-color-primary;
  background-color: $uni-color-primary-lighter;
  border-radius: 8rpx;
}

.item-address {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: $uni-text-color-tertiary;
  
  text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
}

.load-more {
  padding: 32rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: $uni-text-color-secondary;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: $uni-text-color-tertiary;
}
</style>

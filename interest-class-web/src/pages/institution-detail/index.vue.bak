<template>
  <view class="page">
    <view class="detail-container" v-if="!loading && institution">
      <!-- 机构头部 -->
      <view class="institution-header">
        <view class="header-logo">
          <asyncimage
            :src="institution.logo"
            width="160rpx"
            height="160rpx"
            mode="aspectFill"
            :radius="16"
          />
        </view>
        <view class="header-info">
          <view class="info-name">{{ institution.name }}</view>
          <view class="info-tags" v-if="institution.tags">
            <text
              v-for="(tag, index) in institution.tags.split(',')"
              :key="index"
              class="tag"
            >
              {{ tag }}
            </text>
          </view>
          <view class="info-address" v-if="institution.address">
            <wd-icon name="location" size="24rpx" />
            <text>{{ institution.address }}</text>
          </view>
        </view>
      </view>

      <!-- 机构简介 -->
      <view class="section" v-if="institution.introduction">
        <view class="section-title">机构简介</view>
        <view class="section-content">
          <text class="intro-text">{{ institution.introduction }}</text>
        </view>
      </view>

      <!-- 教学环境 -->
      <view class="section" v-if="classroomShowcases.length > 0">
        <view class="section-title">教学环境</view>
        <view class="image-grid">
          <asyncimage
            v-for="(item, index) in classroomShowcases"
            :key="item.id"
            :src="item.img_url"
            width="220rpx"
            height="220rpx"
            mode="aspectFill"
            :radius="8"
            @click="previewShowcases('classroom', index)"
          />
        </view>
      </view>

      <!-- 荣誉时刻 -->
      <view class="section" v-if="institution.honors && institution.honors.length > 0">
        <view class="section-title">荣誉时刻</view>
        <view class="image-grid">
          <asyncimage
            v-for="(item, index) in institution.honors"
            :key="item.id"
            :src="item.img_url"
            width="220rpx"
            height="220rpx"
            mode="aspectFill"
            :radius="8"
            @click="previewHonors(index)"
          />
        </view>
      </view>

      <!-- 学员风采 -->
      <view class="section" v-if="studentShowcases.length > 0">
        <view class="section-title">学员风采</view>
        <view class="image-grid">
          <asyncimage
            v-for="(item, index) in studentShowcases"
            :key="item.id"
            :src="item.img_url"
            width="220rpx"
            height="220rpx"
            mode="aspectFill"
            :radius="8"
            @click="previewShowcases('student_work', index)"
          />
        </view>
      </view>

      <!-- 教师团队 -->
      <view class="section">
        <view class="section-title">
          <text>教师团队</text>
          <text class="more" @click="showAllTeachers" v-if="institution.teachers && institution.teachers.length > 4">查看全部</text>
        </view>
        <view class="teacher-list" v-if="institution.teachers && institution.teachers.length > 0">
          <view
            v-for="teacher in institution.teachers.slice(0, 4)"
            :key="teacher.id"
            class="teacher-item"
          >
            <asyncimage
              :src="teacher.avatar_url"
              width="120rpx"
              height="120rpx"
              mode="aspectFill"
              :radius="60"
            />
            <text class="teacher-name">{{ teacher.name }}</text>
            <text class="teacher-title">{{ teacher.title || '教师' }}</text>
          </view>
        </view>
        <view class="empty-tip" v-else>
          <text>暂无教师信息</text>
        </view>
      </view>

      <!-- 课程列表 -->
      <view class="section">
        <view class="section-title">
          <text>热门课程</text>
          <text class="more" @click="showAllCourses">查看全部</text>
        </view>
        <view class="course-list" v-if="courseList.length > 0">
          <view
            v-for="course in courseList.slice(0, 4)"
            :key="course.id"
            class="course-item"
            @click="goToCourseDetail(course.id)"
          >
            <asyncimage
              :src="course.cover_url"
              width="200rpx"
              height="200rpx"
              mode="aspectFill"
              :radius="8"
            />
            <view class="course-info">
              <view class="course-name">{{ course.title }}</view>
              <view class="course-subtitle" v-if="course.subtitle">
                {{ course.subtitle }}
              </view>
              <view class="course-meta">
                <text class="price">
                  ¥{{ course.skus && course.skus[0] ? course.skus[0].total_price : 0 }}
                </text>
                <text class="sales">{{ course.sales_count || 0 }}人报名</text>
              </view>
            </view>
          </view>
        </view>
        <view class="empty-tip" v-else>
          <text>暂无课程信息</text>
        </view>
      </view>

      <!-- 联系方式 -->
      <view class="section">
        <view class="section-title">联系方式</view>
        <view class="contact-info">
          <view class="contact-item">
            <wd-icon name="phone" />
            <text>{{ institution.contact_phone || '暂无' }}</text>
            <wd-button
              v-if="institution.contact_phone"
              type="primary"
              size="small"
              @click="callPhone"
            >
              拨打电话
            </wd-button>
          </view>
          <view class="contact-item">
            <wd-icon name="location" />
            <text>{{ institution.address || '暂无' }}</text>
            <wd-button
              v-if="institution.latitude && institution.longitude"
              type="primary"
              size="small"
              @click="openMap"
            >
              导航
            </wd-button>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-state" v-if="loading">
      <wd-loading />
      <text>加载中...</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" v-if="!loading && !institution">
      <wd-icon name="shop" size="120rpx" color="#d9d9d9" />
      <text class="empty-text">机构不存在</text>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { institutionApi, type Institution } from '@/api/institution'
import { courseApi, type Course } from '@/api/course'

const institutionId = ref('')
const institution = ref<Institution | null>(null)
const courseList = ref<Course[]>([])
const loading = ref(false)

onLoad((options: any) => {
  if (options.id) {
    institutionId.value = options.id
  }
})

onMounted(async () => {
  await loadInstitutionDetail()
  await loadCourses()
})

// 计算属性：过滤出教学环境类型的showcases
const classroomShowcases = computed(() => {
  if (!institution.value?.showcases) return []
  return institution.value.showcases.filter((item: any) => item.type === 'classroom')
})

// 计算属性：过滤出学员作品类型的showcases
const studentShowcases = computed(() => {
  if (!institution.value?.showcases) return []
  return institution.value.showcases.filter((item: any) => item.type === 'student_work')
})

// 加载机构详情
const loadInstitutionDetail = async () => {
  if (!institutionId.value) {
    uni.showToast({
      title: '缺少机构ID',
      icon: 'none',
    })
    return
  }

  loading.value = true
  try {
    institution.value = await institutionApi.getDetail(institutionId.value)
  } catch (error: any) {
    uni.showToast({
      title: error.message || '加载失败',
      icon: 'none',
    })
  } finally {
    loading.value = false
  }
}

// 加载课程列表
const loadCourses = async () => {
  try {
    const res = await courseApi.getList({
      institutionId: institutionId.value,
      page: 1,
      pageSize: 8,
    })
    courseList.value = res.data
  } catch (error: any) {
    console.error('加载课程失败:', error)
  }
}

// 预览showcases图片
const previewShowcases = (type: string, current: number) => {
  const showcases = type === 'classroom' ? classroomShowcases.value : studentShowcases.value
  const urls = showcases.map((item: any) => item.img_url)
  uni.previewImage({ urls, current })
}

// 预览honors图片
const previewHonors = (current: number) => {
  if (!institution.value?.honors) return
  const urls = institution.value.honors.map((item: any) => item.img_url)
  uni.previewImage({ urls, current })
}

// 查看全部教师
const showAllTeachers = () => {
  uni.navigateTo({
    url: `/pages/teacher-list/index?institutionId=${institutionId.value}`,
  })
}

// 查看全部课程
const showAllCourses = () => {
  uni.navigateTo({
    url: `/pages/course-list/index?institutionId=${institutionId.value}`,
  })
}

// 跳转到课程详情
const goToCourseDetail = (courseId: string) => {
  uni.navigateTo({
    url: `/pages/course-detail/index?id=${courseId}`,
  })
}

// 拨打电话
const callPhone = () => {
  if (!institution.value?.contact_phone) return
  uni.makePhoneCall({
    phoneNumber: institution.value.contact_phone,
  })
}

// 打开地图导航
const openMap = () => {
  if (!institution.value) return
  uni.openLocation({
    latitude: institution.value.latitude,
    longitude: institution.value.longitude,
    name: institution.value.name,
    address: institution.value.address,
  })
}
</script>

<style lang="scss" scoped>

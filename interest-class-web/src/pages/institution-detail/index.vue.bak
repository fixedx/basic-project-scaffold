  font-size: 28rpx;
  color: $uni-text-color-secondary;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.teacher-list {
  display: flex;
  flex-wrap: wrap;
  gap: 32rpx;
}

.teacher-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: 140rpx;
}

.teacher-name {
  font-size: 28rpx;
  color: $uni-text-color;
  font-weight: bold;
}

.teacher-title {
  font-size: 24rpx;
  color: $uni-text-color-tertiary;
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.course-item {
  display: flex;
  gap: 24rpx;
}

.course-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.course-name {
  font-size: 30rpx;
  font-weight: bold;
  color: $uni-text-color;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-subtitle {
  font-size: 26rpx;
  color: $uni-text-color-secondary;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  font-size: 32rpx;
  font-weight: bold;
  color: $uni-color-primary;
}

.sales {
  font-size: 24rpx;
  color: $uni-text-color-tertiary;
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: $uni-text-color;
  
  text {
    flex: 1;
  }
}

.empty-tip {
  padding: 60rpx 0;

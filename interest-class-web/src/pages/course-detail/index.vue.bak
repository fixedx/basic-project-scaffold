  font-size: 28rpx;
  color: $uni-text-color-secondary;
  margin-bottom: 24rpx;
}

.course-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tag {
  font-size: 24rpx;
  color: $uni-color-primary;
  background-color: $uni-color-primary-lighter;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.course-meta {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meta-item {
  font-size: 28rpx;
  color: $uni-text-color;
}

.sku-section {
  padding: 32rpx;
  background-color: $uni-bg-color;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: $uni-text-color;
  margin-bottom: 24rpx;
}

.sku-item {
  padding: 24rpx;
  background-color: $uni-bg-color-grey;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
  
  &.sku-active {
    background-color: $uni-color-primary-lighter;
    border-color: $uni-color-primary;
  }
}

.sku-name {
  font-size: 28rpx;
  font-weight: bold;
  color: $uni-text-color;
  margin-bottom: 12rpx;
}

.sku-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.sku-lessons {
  font-size: 24rpx;
  color: $uni-text-color-secondary;
}

.sku-price {
  font-size: 32rpx;
  font-weight: bold;
  color: $uni-color-primary;
}

.sku-detail {
  font-size: 24rpx;
  color: $uni-text-color-secondary;
}

.description-section {
  padding: 32rpx;
  background-color: $uni-bg-color;
  margin-bottom: 24rpx;
}

.description-content {
  font-size: 28rpx;
  color: $uni-text-color;
  line-height: 1.8;
  white-space: pre-wrap;
}

.institution-section {
  padding: 32rpx;
  background-color: $uni-bg-color;
  margin-bottom: 24rpx;
}

.institution-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background-color: $uni-bg-color-grey;
  border-radius: 16rpx;
}

.institution-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
}

.institution-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.institution-name {
  font-size: 28rpx;
  font-weight: bold;
  color: $uni-text-color;
}

.institution-address {
  font-size: 24rpx;
  color: $uni-text-color-secondary;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 32rpx;
  gap: 32rpx;
}

.error-text {
  font-size: 28rpx;
  color: $uni-text-color-tertiary;
}
</style>

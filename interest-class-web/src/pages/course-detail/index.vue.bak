<template>
  <view class="course-detail-page">
    <!-- 加载状态 -->
    <view class="loading" v-if="loading">
      <wd-loading type="spinner" />
    </view>

    <!-- 课程详情 -->
    <view v-else-if="course">
      <!-- 轮播图 -->
      <swiper
        class="course-swiper"
        :indicator-dots="true"
        :autoplay="false"
        indicator-color="rgba(255, 255, 255, 0.5)"
        indicator-active-color="#52c41a"
      >
        <swiper-item
          v-for="(img, index) in course.slider_imgs || [course.cover_url]"
          :key="index"
        >
          <asyncimage
            :src="img"
            width="100%"
            height="100%"
            mode="aspectFill"
          />
        </swiper-item>
      </swiper>

      <!-- 课程基本信息 -->
      <view class="course-info-section">
        <view class="course-title">{{ course.title }}</view>
        <view class="course-subtitle" v-if="course.subtitle">
          {{ course.subtitle }}
        </view>
        <view class="course-tags" v-if="course.tags && course.tags.length > 0">
          <text
            v-for="tag in course.tags"
            :key="tag"
            class="tag"
          >
            {{ tag }}
          </text>
        </view>
        <view class="course-meta">
          <text class="meta-item" v-if="course.min_age || course.max_age">
            🧒 适合年龄：{{ course.min_age || 0 }}-{{ course.max_age || 99 }}岁
          </text>
          <text class="meta-item" v-if="course.lesson_duration">
            ⏰ 课程时长：{{ course.lesson_duration }}分钟/节
          </text>
          <text class="meta-item">
            📚 课程类型：{{ course.type === 'standard' ? '正式课' : '试听课' }}
          </text>
          <text class="meta-item">
            📺 授课方式：{{ course.is_online ? '在线授课' : '线下授课' }}
          </text>
        </view>
      </view>

      <!-- 价格套餐 -->
      <view class="sku-section" v-if="course.skus && course.skus.length > 0">
        <view class="section-title">价格套餐</view>
        <view
          v-for="sku in course.skus"
          :key="sku.id"
          class="sku-item"
          :class="{ 'sku-active': selectedSku?.id === sku.id }"
          @click="selectSku(sku)"
        >
          <view class="sku-name">{{ sku.name }}</view>
          <view class="sku-info">
            <text class="sku-lessons">{{ sku.total_lessons }}节课</text>
            <text class="sku-price">¥{{ sku.total_price }}</text>
          </view>
          <view class="sku-detail" v-if="sku.cashback_type !== 'none'">
            返现：{{ formatCashback(sku) }}
          </view>
        </view>
      </view>

      <!-- 课程描述 -->
      <view class="description-section" v-if="course.description">
        <view class="section-title">课程介绍</view>
        <view class="description-content">
          {{ course.description }}
        </view>
      </view>

      <!-- 机构信息 -->
      <view class="institution-section" v-if="course.institution">
        <view class="section-title">机构信息</view>
        <view class="institution-card" @click="handleInstitutionClick">
          <asyncimage
            :src="course.institution.logo || '/static/default-institution.png'"
            width="96rpx"
            height="96rpx"
            mode="aspectFill"
            class="institution-logo"
          />
          <view class="institution-info">
            <text class="institution-name">{{ course.institution.name }}</text>
            <text class="institution-address">
              {{ course.institution.address }}
            </text>
          </view>
          <wd-icon name="arrow-right" />
        </view>
      </view>

      <!-- 底部操作栏 -->
      <PageFooter>
        <wd-button @click="handleConsult">咨询</wd-button>
        <wd-button type="primary" @click="handleReserve">立即报名</wd-button>
      </PageFooter>
    </view>

    <!-- 错误状态 -->
    <view class="error-state" v-else>
      <wd-icon name="warning" size="120rpx" color="#d9d9d9" />
      <text class="error-text">课程不存在</text>
      <wd-button type="primary" @click="handleBack">返回</wd-button>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { onLoad } from '@dcloudio/uni-app'
import { courseApi, type Course, type CourseSku } from '@/api'
import { showErrorToast, showSuccessToast } from '@/utils/toast'

const courseId = ref('')
const course = ref<Course | null>(null)
const selectedSku = ref<CourseSku | null>(null)
const loading = ref(false)

// 加载课程详情
const loadCourseDetail = async () => {
  if (!courseId.value) return
  
  loading.value = true
  try {
    const data = await courseApi.getDetail(courseId.value)
    course.value = data
    
    // 默认选中第一个 SKU
    if (data.skus && data.skus.length > 0) {
      selectedSku.value = data.skus[0]
    }
  } catch (error) {
    showErrorToast('加载失败')
  } finally {
    loading.value = false
  }
}

// 选择套餐
const selectSku = (sku: CourseSku) => {
  selectedSku.value = sku
}

// 格式化返现信息
const formatCashback = (sku: CourseSku) => {
  if (sku.cashback_type === 'percentage') {
    return `${sku.cashback_value}%`
  } else if (sku.cashback_type === 'fixed') {
    return `¥${sku.cashback_value}`
  }
  return '无返现'
}

// 点击机构
const handleInstitutionClick = () => {
  if (course.value?.institution) {
    uni.navigateTo({
      url: `/pages/institution-detail/index?id=${course.value.institution.id}`,
    })
  }
}

// 咨询
const handleConsult = () => {
  showSuccessToast('功能开发中')
}

// 报名
const handleReserve = () => {
  if (!selectedSku.value) {
    showErrorToast('请选择套餐')
    return
  }
  showSuccessToast('功能开发中')
}

// 返回
const handleBack = () => {
  uni.navigateBack()
}

onLoad((options) => {
  if (options.id) {
    courseId.value = options.id
  }
})

onMounted(() => {
  loadCourseDetail()
})
</script>

<style lang="scss" scoped>

  padding: 32rpx;
  background-color: $uni-bg-color;
  margin-bottom: 24rpx;
}

.course-title {
  font-size: 36rpx;
  font-weight: bold;
  color: $uni-text-color;
  margin-bottom: 16rpx;
}


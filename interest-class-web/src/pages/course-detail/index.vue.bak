  min-height: 100vh;
  background-color: $uni-bg-color-grey;
  padding-bottom: 160rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 200rpx 0;
}

.course-swiper {
  width: 100%;
  height: 500rpx;
  margin-bottom: 24rpx;
}

